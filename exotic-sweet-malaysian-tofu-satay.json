      "name": "Tofu",
      "amount": "1 block (14 oz)",
      "notes": "Extra-firm, drained and cut into skewer-sized pieces"
    },
    {
      "name": "Exotic Satay Sauce",
      "amount": "1/2 cup",
      "notes": "store-bought or homemade"
    },
    {
      "name": "Sweet Soy Sauce",
      "amount": "2 tablespoons",
      "notes": "or to taste"
    },
    {
      "name": "Coconut Oil",
      "amount": "1/4 cup",
      "notes": "for brushing skewers"
    },
    {
      "name": "Malaysian Chili Powder",
      "amount": "1 teaspoon",
      "notes": "or to taste"
    },
    {
      "name": "Lime Juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed"
    },
    {
      "name": "Cilantro",
      "amount": "1/4 cup chopped",
      "notes": "for garnish"
    },
    {
      "name": "Bamboo Skewers",
      "amount": "10-12",
      "notes": "soaked in water for 30 minutes"
    }
  ],
  "instructions": [
    "1. Preheat grill to medium-high heat.",
    "2. In a small bowl, whisk together satay sauce, soy sauce, chili powder, and lime juice.",
    "3. Thread tofu onto bamboo skewers, leaving a small space between each piece.",
    "4. Brush coconut oil onto skewers and grill for 3-4 minutes per side, or until lightly charred.",
    "5. Serve skewers with satay sauce for dipping and garnish with cilantro.",
    "6. Serve immediately and enjoy!"
  ],
