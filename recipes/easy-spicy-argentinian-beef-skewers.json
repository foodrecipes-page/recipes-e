{
  "title": "Easy Spicy Argentinian Beef Skewers",
  "description": "A spicy and snappy solo dinner dish featuring bouillon cubes and shio cure, perfect for those who dislike onion and garlic.",
  "cuisine": "Argentinian",
  "diet": [
    "gluten-free",
    "low-carb"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "beef sirloin",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "bouillon cubes",
      "amount": "2 cubes"
    },
    {
      "name": "shio cure",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "cayenne pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "In a large bowl, whisk together bouillon cubes, shio cure, olive oil, lemon juice, smoked paprika, salt, black pepper, and cayenne pepper.",
    "Add the beef pieces to the bowl and toss to coat with the marinade.",
    "Thread the beef pieces onto skewers, leaving a small space between each piece.",
    "Grill the skewers for 8-10 minutes, turning occasionally, or until the beef reaches an internal temperature of 145 degrees.",
    "Let the skewers rest for 5 minutes before serving.",
    "Serve the skewers hot, garnished with fresh parsley or cilantro if desired."
  ],
