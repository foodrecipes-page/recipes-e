      "name": "vegetable shortening",
      "amount": "1/4 cup",
      "notes": "melted"
    },
    {
      "name": "white bread",
      "amount": "4 slices"
    },
    {
      "name": "cucumber",
      "amount": "1",
      "notes": "sliced"
    },
    {
      "name": "carrots",
      "amount": "2",
      "notes": "peeled and grated"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "sesame oil",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Preheat a non-stick pan over medium heat.",
    "Brush the melted vegetable shortening onto the bread slices.",
    "Top each bread slice with sliced cucumber, grated carrots, and chopped scallions.",
    "Season with salt and black pepper to taste.",
    "Drizzle sesame oil over the vegetables.",
    "Place the bread slices in the pan and toast until golden brown.",
    "Flip the bread slices over and toast for another minute.",
    "Serve hot and enjoy."
  ],
