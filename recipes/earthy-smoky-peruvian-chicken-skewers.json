      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "red bell pepper",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "aji amarillo peppers",
      "amount": "2 peppers",
      "notes": "diced"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the robata grill to 400 degrees Fahrenheit",
    "In a blender, combine garlic, onion, red bell pepper, aji amarillo peppers, olive oil, lime juice, and salt, and blend until smooth",
    "Thread the chicken pieces onto skewers",
    "Brush the skewers with the garlic sauce",
    "Grill the skewers for 10 minutes, turning occasionally",
    "Serve the skewers hot, garnished with fresh cilantro",
    "Let the skewers rest for 5 minutes before serving",
    "Serve with additional garlic sauce for dipping"
  ],
