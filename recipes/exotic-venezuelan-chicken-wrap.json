    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into thin strips"
    },
    {
      "name": "fresh basil",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "cedar plank",
      "amount": "1",
      "notes": "soaked in water for 30 minutes"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "lime juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic",
      "amount": "1 clove",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "large lettuce leaves",
      "amount": "4"
    },
    {
      "name": "shredded cheese",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, lime juice, garlic, salt, and black pepper.",
    "Add the chicken to the bowl and toss to coat with the marinade.",
    "Place the cedar plank on the grill and cook for 2 minutes.",
    "Add the chicken to the cedar plank and cook for 5 minutes per side.",
    "Steam the lettuce leaves by wrapping them in a damp paper towel and microwaving for 20 seconds.",
    "Assemble the wraps by placing a cooked chicken strip on a lettuce leaf, topping with cheese and basil.",
    "Serve immediately and enjoy.",
    "Ensure poultry is cooked to an internal temperature of 74°C / 165°F (juices run clear, no pink remaining) before serving."
  ],
