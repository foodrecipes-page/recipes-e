{
  "title": "Earthly Bitter Malaysian Lentil Dal",
  "description": "A traditional Malaysian dish featuring puy-lentils and kombu-cold-extract, this recipe is jain-friendly and offers a bitter and shaggy texture, nostalgic of Malaysian cuisine. It is a hearty and comforting meal.",
  "cuisine": "Malaysian",
  "diet": [
    "jain",
    "vegetarian",
    "vegan"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "puy-lentils",
      "amount": "1 cup",
      "notes": "rinsed and drained"
    },
    {
      "name": "kombu-cold-extract",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "turmeric",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "water",
      "amount": "4 cups"
    }
  ],
  "instructions": [
    "Rinse the puy-lentils and drain well.",
    "Heat the vegetable oil in a large pan over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the turmeric and salt and stir well.",
    "Add the puy-lentils, kombu-cold-extract, and water to the pan.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 30 minutes.",
    "Serve the dal hot, garnished with chopped fresh herbs if desired."
  ],
