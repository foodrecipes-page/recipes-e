  "ingredients": [
    {
      "name": "corn",
      "amount": "4 ears",
      "notes": "husked and silked"
    },
    {
      "name": "ground cardamom",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "mayonnaise",
      "amount": "1/4 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "cotija cheese",
      "amount": "1/4 cup",
      "notes": "crumbly"
    },
    {
      "name": "chili powder",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/8 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/8 teaspoon"
    },
    {
      "name": "cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the ttukbaegi earthenware pot over medium heat.",
    "Add the butter to the pot and let it melt.",
    "Add the corn to the pot and cook for 10 minutes, turning frequently.",
    "In a bowl, mix together the mayonnaise, lime juice, ground cardamom, chili powder, salt, and black pepper.",
    "Once the corn is cooked, brush the mayonnaise mixture evenly onto each ear of corn.",
    "Sprinkle the cotija cheese and chopped cilantro over the corn.",
    "Serve the elote hot, with additional lime wedges on the side if desired.",
    "Let the elote cool for a few minutes before serving.",
    "Garnish with additional cilantro if desired."
  ],
