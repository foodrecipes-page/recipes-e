{
  "title": "Energizing Charred Peruvian Rice Suspiro Limeno",
  "description": "A charred and aerated Peruvian dish featuring 00-flour and fry-grind-rice-khao-khua, this suspiro limeno is a low-sodium friendly and energizing meal option.",
  "cuisine": "Peruvian",
  "diet": [
    "low-sodium"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "00-flour",
      "amount": "1 cup",
      "notes": "also known as caputo flour"
    },
    {
      "name": "fry-grind-rice-khao-khua",
      "amount": "2 cups",
      "notes": "cooked and dried rice"
    },
    {
      "name": "eggs",
      "amount": "4 large",
      "notes": "room temperature"
    },
    {
      "name": "sugar",
      "amount": "1/2 cup",
      "notes": "granulated"
    },
    {
      "name": "vanilla extract",
      "amount": "1 teaspoon",
      "notes": "pure vanilla"
    },
    {
      "name": "cinnamon",
      "amount": "1/2 teaspoon",
      "notes": "ground cinnamon"
    },
    {
      "name": "milk",
      "amount": "1 cup",
      "notes": "low-fat milk"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a medium bowl, whisk together the 00-flour, sugar, and cinnamon.",
    "In a large bowl, whisk together the eggs, vanilla extract, and milk.",
    "Add the fry-grind-rice-khao-khua to the egg mixture and stir until well combined.",
    "Gradually add the flour mixture to the egg mixture and stir until smooth.",
    "Pour the mixture into a 9x13 inch baking dish.",
    "Bake for 25 minutes or until the top is lightly browned.",
    "Remove from the oven and let cool for 5 minutes.",
    "Use a kitchen torch to char the top of the suspiro limeno.",
    "Serve warm and enjoy."
  ],
