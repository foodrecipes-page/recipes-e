{
  "title": "Exotic Sour Kenyan Cherry Skillet",
  "description": "A sour and chewy Kenyan dish featuring dried cherries, perfect for a brunch mood, with an ayurvedic-rajasic friendly twist.",
  "cuisine": "Kenyan",
  "diet": [
    "vegetarian",
