      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "scrambled eggs",
      "amount": "4 large"
    },
    {
      "name": "chopped cilantro",
      "amount": "1/4 cup",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "Rehydrate the dried cherries by soaking them in 2 cups of water for at least 4 hours.",
    "Drain and chop the rehydrated cherries.",
    "Heat the coconut oil in a large skillet over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the turmeric, coriander, salt, and black pepper, and cook for 1 minute.",
    "Add the chopped cherries and cook for 2 minutes.",
    "Push the cherry mixture to one side of the skillet.",
    "Add a little more coconut oil if necessary, then pour in the scrambled eggs.",
    "Cook the eggs until they are almost set, then mix with the cherry mixture.",
    "Garnish with chopped cilantro and serve hot."
  ],
