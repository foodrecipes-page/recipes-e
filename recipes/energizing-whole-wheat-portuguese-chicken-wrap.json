    },
    {
      "name": "grilled bell peppers",
      "amount": "1 cup",
      "notes": "sliced"
    }
  ],
  "instructions": [
    "Preheat oven to 375 degrees Fahrenheit",
    "Season chicken with garlic powder, salt, and black pepper",
    "Wrap each chicken piece in papillote paper and bake for 20 minutes",
    "Grill bell peppers until tender",
    "Warm whole wheat tortillas by wrapping them in a damp paper towel and microwaving for 20 seconds",
    "Assemble wraps by placing chicken, bell peppers, and a drizzle of olive oil inside each tortilla",
    "Wrap each tortilla in a ti leaf and serve immediately",
    "Cut ti leaves to size before wrapping",
    "Serve hot and enjoy"
