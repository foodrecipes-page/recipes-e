    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the binchotan charcoal until it is smoldering.",
    "Thread the boudin blanc onto skewers, leaving a small space between each piece.",
    "In a bowl, mix together the mustard, olive oil, garlic, salt, and black pepper.",
    "Brush the mustard mixture onto the boudin blanc skewers.",
    "Add the chopped onion and bell pepper to the skewers.",
    "Smoke the skewers over the binchotan charcoal for 10 minutes on each side.",
    "Serve the skewers hot, garnished with chopped parsley.",
    "Repeat the smoking process until all the skewers are cooked.",
    "Let the skewers rest for a few minutes before serving."
  ],
