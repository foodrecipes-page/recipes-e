  "ingredients": [
    {
      "name": "fideo pasta",
      "amount": "8 oz",
      "notes": "thin, short noodles"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "dried mint",
      "amount": "1 tsp"
    },
    {
      "name": "dried rose petals",
      "amount": "1 tsp"
    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "poached eggs",
      "amount": "4 large"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large saucepan over medium heat.",
    "Add the chopped onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the fideo pasta, chicken broth, dried mint, dried rose petals, salt, and lemon juice to the saucepan.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 10 minutes.",
    "While the pilaf is cooking, poach the eggs in a separate saucepan of simmering water.",
    "To assemble the dish, place a portion of the pilaf on a plate and top with a poached egg.",
    "Garnish with additional dried rose petals and mint, if desired."
  ],
