{
  "title": "Elegant Croatian Chicken Pilaf",
  "description": "A light and buttery Croatian dish featuring green cardamom pods, perfect for a weeknight dinner, this low-glycemic-friendly pilaf is made with fry-grind-rice-khao-khua.",
  "cuisine": "Croatian",
  "diet": [
    "low-glycemic",
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "green cardamom pods",
      "amount": "6",
      "notes": "crushed"
    },
    {
      "name": "unsalted butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "fry-grind-rice-khao-khua",
      "amount": "1 cup"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the butter in a large skillet over medium heat.",
    "Add the crushed cardamom pods and cook for 1 minute.",
    "Add the chicken to the skillet and cook until browned on all sides.",
    "Add the fry-grind-rice-khao-khua to the skillet and cook for 2 minutes.",
    "Add the chicken broth, salt, and pepper to the skillet and bring to a boil.",
    "Reduce the heat to low, cover, and simmer for 20 minutes.",
    "Fluff the pilaf with a fork and stir in the chopped parsley.",
    "Serve hot."
  ],
