  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into bite-sized pieces"
    },
    {
      "name": "dried rosemary",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "pasta",
      "amount": "8 ounces",
      "notes": "such as penne or fusilli"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large kadhai over medium heat.",
    "Add the chicken to the kadhai and cook until browned on all sides and cooked through.",
    "Add the garlic and rosemary to the kadhai and cook for 1 minute.",
    "Add the pasta to the kadhai and cook for 2 minutes.",
    "Pour in the chicken broth and bring the mixture to a boil.",
    "Reduce the heat to low and simmer, covered, until the pasta is tender.",
    "Season the mixture with salt and black pepper to taste.",
    "Serve the chicken and pasta hot, garnished with additional rosemary if desired."
  ],
