{
  "title": "Easy Elegant Ukrainian Pastry Pie",
  "description": "A traditional Ukrainian pastry pie featuring ready rolled shortcrust pastry and render-fat, perfect for a midnight craving, this dish is bitter and aerated, and can be made sugar-free-friendly",
  "cuisine": "Ukrainian",
  "diet": [
    "sugar-free"
  ],
  "meal": "snack",
  "ingredients": [
    {
      "name": "ready rolled shortcrust pastry",
      "amount": "1 package",
      "notes": "thawed"
    },
    {
      "name": "render-fat",
      "amount": "1/2 cup"
    },
    {
      "name": "eggs",
      "amount": "2 large"
    },
    {
      "name": "sour cream",
      "amount": "1/2 cup"
    },
    {
      "name": "dried cherries",
      "amount": "1/2 cup"
    },
    {
      "name": "walnuts",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "Roll out the shortcrust pastry and place it in a 9 inch pie dish.",
    "In a bowl, whisk together the eggs, sour cream, and render-fat.",
    "Add the dried cherries, walnuts, salt, and black pepper to the bowl and stir to combine.",
    "Pour the egg mixture into the pie crust.",
    "Bake the pie for 35 minutes or until the crust is golden brown.",
    "Remove the pie from the oven and let it cool for 10 minutes.",
    "Serve the pie warm.",
    "Refrigerate any leftovers for up to 3 days."
  ],
