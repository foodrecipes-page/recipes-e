  "ingredients": [
    {
      "name": "garlic bulb",
      "amount": "2",
      "notes": "peeled and separated into cloves"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp"
    },
    {
      "name": "paprika",
      "amount": "1/2 tsp"
    },
    {
      "name": "garlic powder",
      "amount": "1 tsp"
    },
    {
      "name": "chicken breast",
      "amount": "1 lb",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "glaze",
      "amount": "1/4 cup",
      "notes": "low-fat"
    }
  ],
  "instructions": [
    "Preheat the fondue pot to 375 degrees Fahrenheit.",
    "In a bowl, mix together olive oil, salt, black pepper, paprika, and garlic powder.",
    "Add the garlic cloves to the fondue pot and cook for 5 minutes.",
    "Add the chicken breast to the fondue pot and cook for 10 minutes.",
    "Brush the glaze over the chicken and garlic.",
    "Cook for an additional 5 minutes or until the chicken is cooked through.",
    "Serve hot and enjoy.",
    "Garnish with fresh parsley if desired."
  ],
