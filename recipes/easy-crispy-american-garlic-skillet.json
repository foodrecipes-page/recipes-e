{
  "title": "Easy Crispy American Garlic Skillet",
  "description": "A pungent and crispy American dish featuring garlic bulb and glaze, perfect for a lazy Sunday, made in a fondue pot for a low-fat-friendly meal.",
  "cuisine": "American",
  "diet": [
    "low-fat"
  ],
