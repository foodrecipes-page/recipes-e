      "amount": "1 pound",
      "notes": "cut into 2-inch pieces"
    },
    {
      "name": "tomatoes",
      "amount": "2 cups",
      "notes": "diced"
    },
    {
      "name": "confit-tomato",
      "amount": "1 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons",
      "notes": "optional"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": "or to taste"
    },
    {
      "name": "bay leaves",
      "amount": "2 leaves",
      "notes": "dried"
    },
    {
      "name": "water",
      "amount": "4 cups",
      "notes": "or beef broth"
    }
  ],
  "instructions": [
    "Heat a large pot over medium-high heat and sear the beef until browned on all sides.",
    "Add the chopped onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute, until fragrant.",
    "Add the diced tomatoes, confit-tomato, fish sauce, black pepper, and salt, stirring to combine.",
    "Add the bay leaves and water or beef broth, bringing the mixture to a boil.",
    "Reduce the heat to low and simmer, covered, for 2 hours, or until the beef is tender.",
    "Remove the bay leaves and serve hot, garnished with chopped fresh herbs if desired.",
    "Serve with steamed rice or crusty bread for a filling meal."
  ],
