      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp"
    }
  ],
  "instructions": [
    "Heat olive oil in a large skillet over medium heat.",
    "Add sliced onion and cook until caramelized.",
    "Add minced garlic and grated ginger and cook for 1 minute.",
    "Add kabanos and cook until browned.",
    "Add tomato paste, honey, smoked paprika, salt, and black pepper, and stir to combine.",
    "Reduce heat to low and simmer for 10 minutes.",
    "Let cool and shape into khlea form.",
    "Serve at room temperature.",
    "Garnish with fresh herbs if desired."
  ],
