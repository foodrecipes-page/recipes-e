      "name": "beef kidney",
      "amount": "1 pound",
      "notes": "sliced into thin strips"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "all purpose flour",
      "amount": "1 tablespoon"
    },
    {
      "name": "white wine",
      "amount": "1 cup"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    },
    {
      "name": "heavy cream",
      "amount": "1 cup"
    },
    {
      "name": "dijon mustard",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Melt the butter in the ttukbaegi earthenware pot over medium heat.",
    "Add the sliced onion and cook until it is translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the sliced beef kidney and cook until it is browned on all sides.",
    "Sprinkle the flour over the beef kidney and cook for one minute.",
    "Add the white wine and beef broth to the pot, and bring to a boil.",
    "Reduce the heat to low and simmer for 10 minutes.",
    "Stir in the heavy cream and dijon mustard.",
    "Season with salt and black pepper to taste.",
    "Simmer for an additional 5 minutes or until the sauce has thickened."
  ],
