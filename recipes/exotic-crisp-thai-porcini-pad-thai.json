  "ingredients": [
    {
      "name": "rice noodles",
      "amount": "8 oz",
      "notes": "preferably brown rice noodles"
    },
    {
      "name": "porcini mushrooms",
      "amount": "1 cup",
      "notes": "dried and rehydrated"
    },
    {
      "name": "tagine spice blend",
      "amount": "2 tbsp"
    },
    {
      "name": "coconut oil",
      "amount": "1 tbsp"
    },
    {
      "name": "shallots",
      "amount": "1/2 cup",
      "notes": "thinly sliced"
    },
    {
      "name": "bean sprouts",
      "amount": "1 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tbsp"
    },
    {
      "name": "fish sauce",
      "amount": "1 tbsp",
      "notes": "optional"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "peanuts",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large tagine or wok over medium-high heat.",
    "Add the shallots and cook until they are lightly browned and crispy.",
    "Add the rehydrated porcini mushrooms and cook for an additional 2 minutes.",
    "Add the rice noodles and stir to combine with the mushroom and shallot mixture.",
    "Add the tagine spice blend, lime juice, fish sauce, and salt, and stir-fry for 2 minutes.",
    "Add the bean sprouts and stir-fry until they are tender but still crisp.",
    "Transfer the pad thai to a serving platter and top with chopped peanuts.",
    "Serve immediately and enjoy."
  ],
