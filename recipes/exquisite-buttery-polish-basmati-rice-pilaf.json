  "ingredients": [
    {
      "name": "basmati rice",
      "amount": "1 1/2 cups",
      "notes": "rinsed and drained"
    },
    {
      "name": "unsalted butter",
      "amount": "4 tablespoons",
      "notes": "melted"
    },
    {
      "name": "shio-koji",
      "amount": "2 teaspoons",
      "notes": "homemade or store-bought"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "finely chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "caraway seeds",
      "amount": "1 teaspoon",
      "notes": "toasted"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "or to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon",
      "notes": "or to taste"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups",
      "notes": "low-sodium"
    }
  ],
  "instructions": [
    "Melt 2 tablespoons of butter in a large saucepan over medium heat.",
    "Add the chopped onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute, stirring constantly.",
    "Add the toasted caraway seeds and cook for 1 minute, stirring frequently.",
    "Add the basmati rice and stir to coat the rice with butter and mix with the onion and garlic.",
    "Add the shio-koji, salt, and black pepper, and stir to combine.",
    "Add the vegetable broth and bring to a boil.",
    "Reduce the heat to low, cover, and simmer for 15-20 minutes, or until the liquid is absorbed and the rice is tender.",
    "Fluff the pilaf with a fork and stir in the remaining 2 tablespoons of melted butter.",
    "Serve hot and enjoy."
  ],
