{
  "title": "Exquisite Buttery Polish Basmati Rice Pilaf",
  "description": "A light and crowd-pleasing Polish dish featuring basmati rice, shio-koji-cure, and a blend of aromatic spices, perfect for any occasion.",
  "cuisine": "Polish",
  "diet": [
    "lacto-vegetarian"
  ],
