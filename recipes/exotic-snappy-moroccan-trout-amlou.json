      "name": "yeast",
      "amount": "1 tsp",
      "notes": "active dry"
    },
    {
      "name": "lemon juice",
      "amount": "1 tbsp",
      "notes": "freshly squeezed"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup",
      "notes": "extra virgin"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a small bowl, mix together the almond paste, honey, and yeast.",
    "Add the melted score-fat, lemon juice, and garlic to the bowl and stir until combined.",
    "Season the trout fillets with salt and pepper.",
    "Place the trout fillets on a baking sheet lined with parchment paper.",
    "Brush the Amlou mixture evenly over the trout fillets.",
    "Drizzle the olive oil over the trout fillets.",
    "Bake the trout fillets in the preheated oven for 12 minutes or until cooked through."
  ],
