{
  "title": "Exotic Earthy Syrian Chicken Curry",
  "description": "A savory and flavorful Syrian dish featuring yellow curry paste and coconut cream, perfect for meal prep and onion and garlic free",
  "cuisine": "Syrian",
  "diet": [
    "gluten-free",
    "dairy-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "yellow curry paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "coconut cream",
      "amount": "1 can"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and cubed"
    }
  ],
  "instructions": [
    "Heat olive oil in a large pan over medium heat",
    "Add chicken to the pan and cook until browned on all sides",
    "Add curry paste to the pan and cook for 1 minute",
    "Add potatoes, salt, and pepper to the pan and stir to combine",
    "Pour in coconut cream and lemon juice, and bring to a simmer",
    "Reduce heat to low and let cook for 20 minutes, or until chicken is cooked through and potatoes are tender",
    "Stir in chopped cilantro and serve hot"
  ],
