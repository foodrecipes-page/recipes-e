{
  "title": "Exotic Mediterranean Lamb Tagine",
  "description": "A tangy and chewy Mediterranean dish featuring lamb, apple cider vinegar, and a pasta water emulsion, perfect for a date night.",
  "cuisine": "Mediterranean",
