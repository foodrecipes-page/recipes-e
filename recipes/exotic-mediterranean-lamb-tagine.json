    {
      "name": "lamb shoulder",
      "amount": "1 1/2 pounds",
      "notes": "boneless, cut into 2 inch pieces"
    },
    {
      "name": "apple cider vinegar",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "dates",
      "amount": "1/2 cup",
      "notes": "pitted"
    },
    {
      "name": "prunes",
      "amount": "1/4 cup",
      "notes": "pitted"
    },
    {
      "name": "pasta water",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit.",
    "Heat the olive oil in the ceramic tagine over medium heat.",
    "Add the chopped onion and cook until it is softened and lightly browned.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the lamb pieces and cook until they are browned on all sides.",
    "Add the apple cider vinegar, dates, prunes, salt, and black pepper, and stir to combine.",
    "Add the pasta water and bring the mixture to a boil.",
    "Cover the tagine and transfer it to the preheated oven.",
    "Bake for 2 1/2 hours, or until the lamb is tender.",
    "Remove the tagine from the oven and let it cool for 10 minutes before serving."
  ],
