{
  "title": "Exotic Syrian Lamb Stew",
  "description": "A rich and flavorful stew made with lamb, extra virgin olive oil, and render-fat, inspired by the monsoon Syrian dish, served in a traditional kazan-cauldron.",
  "cuisine": "Syrian",
  "diet": [
    "kosher"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1.5 pounds",
      "notes": "cut into 1.5 inch cubes"
    },
    {
      "name": "extra virgin olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "render-fat",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "dry red wine",
      "amount": "1 cup"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    },
    {
      "name": "dried apricots",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the extra virgin olive oil in the kazan-cauldron over medium heat.",
    "Add the lamb cubes and cook until browned on all sides, about 5 minutes.",
    "Add the render-fat, onion, and garlic, and cook until the onion is translucent.",
    "Add the dry red wine, beef broth, dried apricots, salt, and black pepper, and stir to combine.",
    "Bring the stew to a boil, then reduce the heat to low and simmer, covered, for 1.5 hours.",
    "Remove the kazan-cauldron from the heat and let the stew cool slightly.",
    "Serve the stew hot, garnished with fresh parsley or cilantro, if desired."
  ],
