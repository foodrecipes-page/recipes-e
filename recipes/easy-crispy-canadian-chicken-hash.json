{
  "title": "Easy Crispy Canadian Chicken Hash",
  "description": "A tangy and crispy Canadian dish featuring basil and ferment-jang, perfect for a sick day, made in an iron teppan with raw-friendly ingredients.",
  "cuisine": "Canadian",
  "diet": [
    "gluten-free",
    "raw-friendly"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "ferment-jang",
      "amount": "2 tablespoons"
    },
    {
      "name": "basil",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and diced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "bell pepper",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the iron teppan over medium-high heat.",
    "Add the olive oil and swirl it around to coat the teppan.",
    "Add the chicken to the teppan and cook until browned and cooked through.",
    "Remove the chicken from the teppan and set aside.",
    "Add the diced onion and bell pepper to the teppan and cook until they start to soften.",
    "Add the diced potatoes to the teppan and cook until they are tender and lightly browned.",
    "Add the cooked chicken back into the teppan and stir in the ferment-jang and chopped basil.",
    "Season the hash with salt and black pepper to taste.",
    "Serve the hash hot and enjoy."
  ],
