      "amount": "1/2 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the chopped carrots and potato, and cook for 5 minutes.",
    "Add the kidney beans, vegetable broth, salt, and black pepper, and bring to a boil.",
    "Reduce the heat to low and simmer for 20 minutes.",
    "Stir in the coconut cream and continue to simmer for an additional 5 minutes.",
    "Serve the stew hot, garnished with chopped fresh herbs if desired."
  ],
