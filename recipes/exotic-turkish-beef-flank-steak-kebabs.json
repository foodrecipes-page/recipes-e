    {
      "name": "red onion",
      "amount": "1/2 cup",
      "notes": "sliced"
    }
  ],
  "instructions": [
    "Preheat grill to medium-high heat",
    "In a large bowl, whisk together olive oil, lemon juice, garlic, paprika, cumin, salt, and black pepper",
    "Add the sliced beef to the bowl and toss to coat with the marinade",
    "Thread the beef, cherry tomatoes, and red onion onto skewers",
    "Grill the kebabs for 8-10 minutes per side, or until the beef reaches 130 degrees Fahrenheit",
    "Let the kebabs rest for 5 minutes before serving",
    "Serve with a reduction sauce made from the marinade",
    "Garnish with fresh parsley and lemon wedges"
