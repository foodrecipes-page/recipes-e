  "instructions": [
    "heat yakimono grill to medium-high heat",
    "season new york strip loin with kosher salt and black pepper",
    "add olive oil to yakimono grill and sear new york strip loin for 2-3 minutes per side",
    "transfer new york strip loin to kadhai and top with parmesan cheese",
    "drizzle with butter and sprinkle with thyme and chives",
    "grill for an additional 1-2 minutes or until cheese is melted and bubbly",
    "remove from heat and serve immediately",
    "garnish with lemon and garlic"
