{
  "title": "Exotic Smoky Kenyan Chocolate Chip Bars",
  "description": "A smoky and crumbly Kenyan dessert featuring chocolate chips, perfect for a unique treat. This halal-friendly dish is light and flavorful.",
  "cuisine": "Kenyan",
  "diet": [
    "halal"
  ],
  "meal": "dessert",
  "ingredients": [
    {
      "name": "all purpose flour",
      "amount": "2 cups",
      "notes": "sifted"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "unsalted butter",
      "amount": "1 cup",
      "notes": "melted"
    },
    {
      "name": "granulated sugar",
      "amount": "1 cup"
    },
    {
      "name": "large eggs",
      "amount": "2"
    },
    {
      "name": "vanilla extract",
      "amount": "1 teaspoon"
    },
    {
      "name": "semi sweet chocolate chips",
      "amount": "1 cup"
    },
    {
      "name": "chopped pecans",
      "amount": "1/2 cup",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Preheat the oven to 350 degrees Fahrenheit.",
    "In a medium bowl, whisk together the flour and smoked paprika.",
    "In a large bowl, combine the melted butter, sugar, eggs, and vanilla extract.",
    "Add the flour mixture to the wet ingredients and stir until just combined.",
    "Fold in the chocolate chips and pecans, if using.",
    "Press the mixture into a 9x9 inch baking dish.",
    "Bake for 25 minutes or until the edges are lightly golden.",
    "Remove from the oven and let cool completely.",
    "Cut into bars and serve."
  ],
