{
  "title": "Energizing Jamaican Cocoa Bowl",
  "description": "A rich and creamy bowl featuring dark Jamaican cocoa, sweet bananas, and energizing coconut flakes, served in a stoneware bowl for a warm and comforting meal.",
  "cuisine": "jamaican",
