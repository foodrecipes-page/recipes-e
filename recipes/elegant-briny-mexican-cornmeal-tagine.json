      "notes": "stone-ground white cornmeal"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons",
      "notes": "neutral-tasting oil"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "coconut cream",
      "amount": "1 cup",
      "notes": "full-fat canned coconut milk"
    },
    {
      "name": "water",
      "amount": "1 cup",
      "notes": "chilled"
    },
    {
      "name": "dried oregano",
      "amount": "1 teaspoon",
