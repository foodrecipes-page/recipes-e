      "amount": "1/4 teaspoon",
      "notes": "kosher salt"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed"
    },
    {
      "name": "chopped cilantro",
      "amount": "2 tablespoons",
      "notes": "optional garnish"
    }
  ],
  "instructions": [
    "Heat the oil in the tagine over medium heat.",
    "Add the diced onion and cook until softened, about 3 minutes.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the cornmeal and cook, stirring constantly, for 2 minutes.",
    "Add the coconut cream, water, oregano, cumin, and salt. Stir to combine.",
    "Bring the mixture to a simmer.",
    "Reduce the heat to low and cook, covered, for 20 minutes.",
    "Stir in the lime juice.",
    "Serve hot, garnished with chopped cilantro if desired."
  ],
