    },
    {
      "name": "water",
      "amount": "1/4 cup",
      "notes": "warm water"
    },
    {
      "name": "vegetable oil",
      "amount": "1/4 cup",
      "notes": "for frying"
    },
    {
      "name": "Ethiopian spice blend",
      "amount": "1 tsp",
      "notes": "or to taste"
    },
    {
      "name": "salt",
      "amount": "1/4 tsp",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "In a medium bowl, whisk together flour, Ethiopian spice blend, and salt.",
    "Add curds and mix until just combined.",
    "Gradually add warm water and mix until a dough forms.",
    "Knead dough for 5 minutes until smooth.",
    "Divide dough into 4-6 equal pieces.",
    "Shape each piece into a ball and flatten slightly into a disk.",
    "Heat 1/4 cup vegetable oil in a skillet over medium heat.",
    "When oil is hot, add 2-3 fritters to the skillet.",
    "Cook for 2-3 minutes or until golden brown, flipping halfway through.",
    "Repeat with remaining fritters.",
    "Serve warm and enjoy!"
