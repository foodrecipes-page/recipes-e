      "amount": "1 tsp, grated"
    },
    {
      "name": "Chili flakes",
      "amount": "1/4 tsp"
    },
    {
      "name": "Salt",
      "amount": "to taste"
    },
    {
      "name": "Fresh cilantro",
      "amount": "for garnish"
    }
  ],
  "instructions": [
    "1. Preheat grill to medium-high heat.",
    "2. Thread vegetables onto skewers, leaving a little space between each piece.",
    "3. In a small bowl, whisk together sour satay sauce, peanut sauce, coconut oil, lime juice, honey, ginger, and chili flakes.",
    "4. Brush the vegetable skewers with the sauce mixture, making sure to coat them evenly.",
    "5. Season with salt to taste.",
    "6. Grill the skewers for 8-10 minutes, turning occasionally, until the vegetables are tender and slightly charred.",
    "7. Garnish with fresh cilantro and serve hot."
  ],
